# ==============================================================================
# AI DevFest 2026 - Smart Escape Repository .gitignore
# ==============================================================================

# --- Node & Build Dependencies ---
node_modules/
.pnp
.pnp.js

# --- Production & Build Outputs ---
dist/
dist-ssr/
build/
out/
.next/
.output/
*.tsbuildinfo

# --- Environment & Secret Protection (Rulebook 5.8 Zero Secrets) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# --- Contest Organizer Raw Document Exclusions ---
# Exclude raw problem PDF handouts from public repository commit history
*.pdf
README_START_HERE.txt

# --- Editor & IDE Files ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# --- Operating System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- Logs & Debug Dumps ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Testing & Coverage ---
coverage/
.nyc_output/

# --- Scratch & Temporary Files ---
scratch/
tmp/
temp/
*.tmp
*.temp
